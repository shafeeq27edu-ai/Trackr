# Application Settings
YOLO_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.3
HARDWARE_ACCELERATION=auto

# Directories
TEMP_DIR=data/temp
OUTPUT_DIR=outputs/api
LOG_DIR=outputs
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security (Change in production!)
SECRET_KEY=changeme-generate-your-own-with-secrets.token_hex(32)
POSTGRES_USER=placeholder_user
POSTGRES_PASSWORD=placeholder_password

# Frontend Settings
API_BASE_URL=http://localhost:8000/api/v1
SYS_API_BASE_URL=http://localhost:8000/api/v1/system
